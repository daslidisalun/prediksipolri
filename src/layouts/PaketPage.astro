---
import Base from './Base.astro';
import { SITE_NAME, withBase, absolute, jalurBySlug } from '../config/site';
import { HURUF, hitungTopik, type Paket } from '../lib/paket';

interface Props { paket: Paket }
const { paket } = Astro.props;
const jalur = jalurBySlug(paket.jalur)!;
const pageUrl = absolute(`/paket/${paket.slug}/`);
const komposisi = hitungTopik(paket);

const faqData = [
  {
    q: `Ada berapa soal dalam ${paket.judul} ini?`,
    a: `Ada ${paket.soal.length} soal pilihan ganda dengan komposisi: ${komposisi.map((k) => `${k.topik} ${k.jumlah} soal`).join(', ')}. Setiap soal langsung diperiksa saat diklik dan dilengkapi pembahasan. Perkiraan waktu pengerjaan sekitar ${paket.durasiMenit} menit, menyerupai ritme CAT akademik yang sesungguhnya.`,
  },
  {
    q: `Apakah soal di paket ini sama dengan soal CAT akademik Polri yang sebenarnya?`,
    a: `Tidak — dan tidak ada situs latihan mana pun yang bisa menjanjikan itu. Panitia penerimaan Polri tidak pernah menerbitkan soal seleksi tahun-tahun sebelumnya; bank soal CAT bersifat rahasia. Yang kami lakukan: menyusun soal latihan orisinal berdasarkan daftar mata uji yang tercantum dalam pengumuman resmi penerimaan Polri untuk jalur ${jalur.nama}, dengan pola dan tingkat kesulitan yang menyerupai ujiannya. Itulah arti kata "prediksi" yang jujur di situs ini.`,
  },
  {
    q: `Bisakah paket ini dicetak untuk latihan di kertas?`,
    a: `Bisa. Gulir ke bagian "Teks Soal & Kunci Jawaban" di halaman ini, lalu gunakan tombol Cetak Paket. Hasil cetak berisi seluruh soal; kunci jawaban dan pembahasan tercetak terpisah di bagian akhir agar kamu tidak mengintip jawaban sebelum selesai.`,
  },
];

const faqLd = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqData.map((f) => ({
    '@type': 'Question',
    name: f.q,
    acceptedAnswer: { '@type': 'Answer', text: f.a },
  })),
};
const crumbsLd = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Beranda', item: absolute('/') },
    { '@type': 'ListItem', position: 2, name: 'Paket Latihan', item: absolute('/paket/') },
    { '@type': 'ListItem', position: 3, name: paket.judul, item: pageUrl },
  ],
};
const learnLd = {
  '@context': 'https://schema.org',
  '@type': 'LearningResource',
  name: paket.judul,
  description: paket.intro,
  url: pageUrl,
  learningResourceType: 'Practice questions',
  educationalLevel: 'Seleksi penerimaan Polri',
  inLanguage: 'id',
  isAccessibleForFree: true,
};
---

<Base title={paket.judul} description={paket.intro} path={`/paket/${paket.slug}/`}>
  <Fragment slot="head">
    <script type="application/ld+json" set:html={JSON.stringify(faqLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(crumbsLd)} />
    <script type="application/ld+json" set:html={JSON.stringify(learnLd)} />
  </Fragment>

  <nav class="breadcrumb">
    <a href={withBase('/')}>beranda</a> / <a href={withBase('/paket/')}>paket latihan</a> / <span>{paket.slug}</span>
  </nav>

  <div class="paket-head">
    <h1>{paket.judul}</h1>
    <div class="paket-meta">
      <span class="chip besar">{jalur.nama}</span>
      <span class="chip besar">{paket.soal.length} soal pilihan ganda</span>
      <span class="chip besar">±{paket.durasiMenit} menit</span>
      <span class="chip besar">Klik jawaban — langsung ketahuan benar atau salah</span>
    </div>
  </div>

  <div id="kuis-app" class="kuis-app"></div>
  <script type="application/json" id="paket-data" set:html={JSON.stringify(paket)}></script>

  <p class="lead narrow" style="margin-top:26px">{paket.intro}</p>
  <p class="petunjuk narrow">
    Paket ini adalah <strong>soal latihan orisinal</strong> yang disusun dari daftar mata uji resmi jalur
    {jalur.nama} dalam pengumuman penerimaan Polri — bukan bocoran dan bukan soal asli seleksi.
    {SITE_NAME} tidak berafiliasi dengan Polri. Mau mengerjakan di kertas? Cetak paketnya dari bagian teks
    di bawah — kunci jawaban tercetak terpisah di bagian akhir.
  </p>

  <section class="print-area" id="teks-terbuka">
    <div class="teks-kepala">
      <h2>Teks Soal & Kunci Jawaban</h2>
      <button class="btn ghost no-print" onclick="window.print()">Cetak Paket</button>
    </div>
    <p class="no-print" style="color:var(--muted)">
      Seluruh soal paket ini dalam bentuk teks — berguna untuk memeriksa soal terlebih dahulu,
      menyalinnya, atau mencetaknya. Kunci jawaban dan pembahasan ada di bagian paling bawah,
      terpisah dari soalnya.
    </p>
    <h3>Soal Pilihan Ganda</h3>
    <ol class="teks-soal">
      {paket.soal.map((s) => (
        <li>
          <p class="tanya">{s.tanya} <span class="topik-tag">({s.topik})</span></p>
          <ol class="teks-opsi" type="A">
            {s.pilihan.map((p) => <li>{p}</li>)}
          </ol>
        </li>
      ))}
    </ol>

    <div class="kunci-area">
      <h2>Kunci Jawaban</h2>
      <p class="kunci-grid">
        {paket.soal.map((s, i) => (
          <span>{i + 1}. <strong>{HURUF[s.kunci]}</strong></span>
        ))}
      </p>
      <h3>Pembahasan</h3>
      <ol class="teks-soal">
        {paket.soal.map((s) => (
          <li><p><strong>Jawaban: {HURUF[s.kunci]}.</strong> {s.bahasan}</p></li>
        ))}
      </ol>
    </div>
  </section>

  <div class="prose narrow">
    <h2>Pertanyaan umum</h2>
    {faqData.map((f) => (
      <details class="faq">
        <summary>{f.q}</summary>
        <p>{f.a}</p>
      </details>
    ))}
    <p>
      Lihat komposisi mata uji semua jalur di <a href={withBase('/kisi-kisi/')}>halaman kisi-kisi</a>
      atau jelajahi <a href={withBase('/paket/')}>semua paket latihan</a>.
    </p>
  </div>

  <script>
    import { initKuis } from '../lib/quiz.js';
    initKuis();
  </script>
</Base>
