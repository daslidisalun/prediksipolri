---
import { SITE_NAME, SITE_DESCRIPTION, withBase, absolute } from '../config/site';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  path: string;
}
const { title, description = SITE_DESCRIPTION, path } = Astro.props;
const canonical = absolute(path);
const fullTitle = title === SITE_NAME ? `${SITE_NAME} — Prediksi Soal Tes Akademik Polri: Latihan CAT Akpol, Bintara & Tamtama` : `${title} · ${SITE_NAME}`;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="theme-color" content="#0c2140" />
    <meta name="color-scheme" content="light" />
    <link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'%3E%3Crect width='100' height='100' rx='20' fill='%230c2140'/%3E%3Cpath d='M50 16 L78 26 V50 C78 68 66 79 50 86 C34 79 22 68 22 50 V26 Z' fill='none' stroke='%23c9a227' stroke-width='7'/%3E%3Cpath d='M38 51 L47 60 L64 41' stroke='%23ffffff' stroke-width='8' fill='none' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@600;700;800&display=swap" rel="stylesheet" />
    <slot name="head" />
  </head>
  <body>
    <header class="site-header">
      <div class="wrap">
        <a class="logo" href={withBase('/')} aria-label={SITE_NAME}>
          <svg class="logo-mark" viewBox="0 0 100 100" aria-hidden="true"><rect width="100" height="100" rx="20" fill="#ffffff" fill-opacity="0.08"/><path d="M50 16 L78 26 V50 C78 68 66 79 50 86 C34 79 22 68 22 50 V26 Z" fill="none" stroke="#c9a227" stroke-width="7"/><path d="M38 51 L47 60 L64 41" stroke="#fff" stroke-width="8" fill="none" stroke-linecap="round" stroke-linejoin="round"/></svg>
          <span>prediksi<strong>polri</strong></span>
        </a>
        <nav class="main-nav">
          <a href={withBase('/paket/')}>Paket Latihan</a>
          <a href={withBase('/kisi-kisi/')}>Kisi-Kisi</a>
          <a href={withBase('/tentang/')}>Tentang</a>
          <a href={withBase('/kontak/')}>Kontak</a>
        </nav>
      </div>
    </header>

    <main class="wrap">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-grid">
          <div>
            <h4>Paket Latihan</h4>
            <ul>
              <li><a href={withBase('/paket/bintara-akademik/')}>Prediksi Soal Akademik Bintara</a></li>
              <li><a href={withBase('/paket/akpol-daerah/')}>Prediksi Soal Akademik Akpol (Daerah)</a></li>
              <li><a href={withBase('/paket/')}>Semua paket</a></li>
            </ul>
          </div>
          <div>
            <h4>Jelajahi</h4>
            <ul>
              <li><a href={withBase('/kisi-kisi/')}>Kisi-kisi & mata uji per jalur</a></li>
              <li><a href={withBase('/tentang/')}>Tentang PrediksiPolri</a></li>
              <li><a href="https://penerimaan.polri.go.id" rel="noopener" target="_blank">Penerimaan resmi: penerimaan.polri.go.id</a></li>
            </ul>
          </div>
          <div>
            <h4>Bantuan</h4>
            <ul>
              <li><a href={withBase('/kontak/')}>Kontak</a></li>
              <li><a href={withBase('/privasi/')}>Kebijakan privasi</a></li>
              <li><a href={withBase('/disclaimer/')}>Disclaimer</a></li>
            </ul>
          </div>
        </div>
        <p class="footer-note">
          {SITE_NAME} adalah situs latihan mandiri dan <strong>tidak berafiliasi</strong> dengan Kepolisian Negara Republik Indonesia.
          Semua soal adalah soal latihan orisinal berdasarkan daftar mata uji dalam pengumuman resmi penerimaan Polri — bukan bocoran dan bukan soal resmi seleksi.
          Pendaftaran resmi hanya melalui penerimaan.polri.go.id dan tidak dipungut biaya. · © 2026 {SITE_NAME}
        </p>
      </div>
    </footer>
  </body>
</html>
